<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista Tree de Cuenta -->
    <record id="view_diogenes_cuenta_tree" model="ir.ui.view">
        <field name="name">diogenes.cuenta.tree</field>
        <field name="model">diogenes.cuenta</field>
        <field name="arch" type="xml">
            <tree string="Cuentas">
                <field name="icono" widget="image" width="30px" height="30px"/>
                <field name="nombre"/>
                <field name="tipo_cuenta"/>
                <field name="institucion"/>
                <field name="numero_cuenta"/>
                <field name="currency_id"/>
                <field name="saldo_actual" widget="monetary"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>
    
    <!-- Vista Form de Cuenta -->
    <record id="view_diogenes_cuenta_form" model="ir.ui.view">
        <field name="name">diogenes.cuenta.form</field>
        <field name="model">diogenes.cuenta</field>
        <field name="arch" type="xml">
            <form string="Cuenta">
                <sheet>
                    <field name="icono" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="nombre" placeholder="Nombre de la cuenta..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tipo_cuenta" widget="radio"/>
                            <field name="institucion"/>
                            <field name="numero_cuenta"/>
                        </group>
                        <group>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="saldo_inicial" widget="monetary"/>
                            <field name="saldo_actual" widget="monetary" readonly="1"/>
                            <field name="color" widget="color"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <group>
                        <field name="descripcion" placeholder="Descripción adicional de la cuenta..."/>
                    </group>
                    
                    <notebook>
                        <page string="Transacciones">
                            <group>
                                <group>
                                    <field name="transaccion_origen_count" readonly="1"/>
                                </group>
                                <group>
                                    <field name="transaccion_destino_count" readonly="1"/>
                                </group>
                            </group>
                            <separator string="Salidas de dinero"/>
                            <field name="transaccion_origen_ids" nolabel="1">
                                <tree>
                                    <field name="fecha"/>
                                    <field name="descripcion"/>
                                    <field name="tipo"/>
                                    <field name="monto" widget="monetary"/>
                                    <field name="state" widget="badge" 
                                           decoration-success="state=='confirmed'"
                                           decoration-info="state=='draft'"
                                           decoration-muted="state=='cancelled'"/>
                                </tree>
                            </field>
                            <separator string="Entradas de dinero"/>
                            <field name="transaccion_destino_ids" nolabel="1">
                                <tree>
                                    <field name="fecha"/>
                                    <field name="descripcion"/>
                                    <field name="tipo"/>
                                    <field name="monto" widget="monetary"/>
                                    <field name="state" widget="badge" 
                                           decoration-success="state=='confirmed'"
                                           decoration-info="state=='draft'"
                                           decoration-muted="state=='cancelled'"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Vista Search de Cuenta -->
    <record id="view_diogenes_cuenta_search" model="ir.ui.view">
        <field name="name">diogenes.cuenta.search</field>
        <field name="model">diogenes.cuenta</field>
        <field name="arch" type="xml">
            <search string="Buscar Cuentas">
                <field name="nombre"/>
                <field name="institucion"/>
                <field name="numero_cuenta"/>
                <field name="tipo_cuenta"/>
                
                <filter string="Activas" name="active" domain="[('active','=',True)]"/>
                <filter string="Inactivas" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Efectivo" name="efectivo" domain="[('tipo_cuenta','=','efectivo')]"/>
                <filter string="Banco" name="banco" domain="[('tipo_cuenta','=','banco')]"/>
                <filter string="Ahorro" name="ahorro" domain="[('tipo_cuenta','=','ahorro')]"/>
                <filter string="Inversión" name="inversion" domain="[('tipo_cuenta','=','inversion')]"/>
                <filter string="Tarjeta Crédito" name="credito" domain="[('tipo_cuenta','=','credito')]"/>
                <filter string="Préstamo" name="prestamo" domain="[('tipo_cuenta','=','prestamo')]"/>
                <separator/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Tipo de Cuenta" name="group_tipo" context="{'group_by':'tipo_cuenta'}"/>
                    <filter string="Institución" name="group_institucion" context="{'group_by':'institucion'}"/>
                    <filter string="Moneda" name="group_currency" context="{'group_by':'currency_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Vista Kanban de Cuenta -->
    <record id="view_diogenes_cuenta_kanban" model="ir.ui.view">
        <field name="name">diogenes.cuenta.kanban</field>
        <field name="model">diogenes.cuenta</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nombre"/>
                <field name="tipo_cuenta"/>
                <field name="saldo_actual"/>
                <field name="currency_id"/>
                <field name="color"/>
                <field name="icono"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image" style="text-align: center; padding: 10px;">
                                <img t-att-src="kanban_image('diogenes.cuenta', 'icono', record.id.raw_value)" 
                                     alt="Icono" style="max-width: 64px; max-height: 64px;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="nombre"/>
                                </strong>
                                <div>
                                    <field name="tipo_cuenta"/>
                                </div>
                                <div class="text-muted">
                                    <field name="institucion"/>
                                </div>
                                <hr/>
                                <div>
                                    <strong>Saldo: </strong>
                                    <field name="saldo_actual" widget="monetary"/> 
                                    <field name="currency_id"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Acción de ventana -->
    <record id="action_diogenes_cuenta" model="ir.actions.act_window">
        <field name="name">Cuentas</field>
        <field name="res_model">diogenes.cuenta</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear la primera cuenta
            </p>
            <p>
                Las cuentas te permiten llevar un registro de tus diferentes fondos:
                efectivo, bancos, tarjetas de crédito, inversiones, etc.
            </p>
        </field>
    </record>
    
    <!-- Menú de Cuentas -->
    <menuitem id="menu_diogenes_cuenta"
              name="Cuentas"
              parent="menu_diogenes_main"
              action="action_diogenes_cuenta"
              sequence="15"/>
              
</odoo>
