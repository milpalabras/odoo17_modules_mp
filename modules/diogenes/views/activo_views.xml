<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Vista Tree de Activo -->
    <record id="view_diogenes_activo_tree" model="ir.ui.view">
        <field name="name">diogenes.activo.tree</field>
        <field name="model">diogenes.activo</field>
        <field name="arch" type="xml">
            <tree string="Activos">
                <field name="nombre"/>
                <field name="tipo"/>
                <field name="valor_compra" widget="monetary"/>
                <field name="valor_estimado" widget="monetary"/>
                <field name="depreciacion" widget="monetary"/>
                <field name="porcentaje_depreciacion" widget="percentage"/>
                <field name="estado_conservacion"/>
                <field name="puede_venderse" widget="boolean_toggle"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>
    
    <!-- Vista Form de Activo -->
    <record id="view_diogenes_activo_form" model="ir.ui.view">
        <field name="name">diogenes.activo.form</field>
        <field name="model">diogenes.activo</field>
        <field name="arch" type="xml">
            <form string="Activo">
                <header>
                    <button name="action_marcar_vendido" string="Marcar como Vendido" 
                            type="object" invisible="active == False" 
                            class="oe_highlight"
                            confirm="¿Está seguro de marcar este activo como vendido?"/>
                </header>
                <sheet>
                    <field name="imagen" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="nombre" placeholder="Nombre del activo..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="tipo"/>
                            <field name="fecha_adquisicion"/>
                            <field name="estado_conservacion"/>
                            <field name="puede_venderse"/>
                        </group>
                        <group>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="valor_compra" widget="monetary"/>
                            <field name="valor_estimado" widget="monetary"/>
                            <field name="depreciacion" widget="monetary" readonly="1"/>
                            <field name="porcentaje_depreciacion" widget="percentage" readonly="1"/>
                        </group>
                    </group>
                    
                    <group>
                        <group>
                            <field name="ubicacion"/>
                            <field name="numero_serie"/>
                        </group>
                        <group>
                            <field name="meta_financiera_id"/>
                            <field name="user_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Descripción">
                            <group>
                                <field name="descripcion" placeholder="Descripción detallada del activo..." nolabel="1"/>
                            </group>
                        </page>
                        <page string="Notas">
                            <group>
                                <field name="notas" placeholder="Notas adicionales..." nolabel="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    
    <!-- Vista Kanban de Activo -->
    <record id="view_diogenes_activo_kanban" model="ir.ui.view">
        <field name="name">diogenes.activo.kanban</field>
        <field name="model">diogenes.activo</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="nombre"/>
                <field name="tipo"/>
                <field name="valor_estimado"/>
                <field name="currency_id"/>
                <field name="estado_conservacion"/>
                <field name="puede_venderse"/>
                <field name="color"/>
                <field name="imagen"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_color_#{kanban_getcolor(record.color.raw_value)} oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('diogenes.activo', 'imagen', record.id.raw_value)" 
                                     alt="Imagen" style="max-width: 100px; max-height: 100px;"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="nombre"/>
                                </strong>
                                <div>
                                    <field name="tipo"/>
                                </div>
                                <div>
                                    <span>Estado: </span><field name="estado_conservacion"/>
                                </div>
                                <hr/>
                                <div>
                                    <strong>Valor Estimado: </strong>
                                    <field name="valor_estimado" widget="monetary"/> 
                                    <field name="currency_id"/>
                                </div>
                                <div t-if="record.puede_venderse.raw_value">
                                    <span class="badge badge-success">Disponible para venta</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    
    <!-- Vista Search de Activo -->
    <record id="view_diogenes_activo_search" model="ir.ui.view">
        <field name="name">diogenes.activo.search</field>
        <field name="model">diogenes.activo</field>
        <field name="arch" type="xml">
            <search string="Buscar Activos">
                <field name="nombre"/>
                <field name="tipo"/>
                <field name="ubicacion"/>
                <field name="numero_serie"/>
                
                <filter string="Activos" name="active" domain="[('active','=',True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active','=',False)]"/>
                <separator/>
                <filter string="Disponible para Venta" name="vendible" domain="[('puede_venderse','=',True)]"/>
                <separator/>
                <filter string="Inmuebles" name="inmueble" domain="[('tipo','=','inmueble')]"/>
                <filter string="Vehículos" name="vehiculo" domain="[('tipo','=','vehiculo')]"/>
                <filter string="Electrónicos" name="electronico" domain="[('tipo','=','electronico')]"/>
                <filter string="Mobiliario" name="mobiliario" domain="[('tipo','=','mobiliario')]"/>
                <separator/>
                <filter string="Estado Excelente" name="excelente" domain="[('estado_conservacion','=','excelente')]"/>
                <filter string="Estado Bueno" name="bueno" domain="[('estado_conservacion','=','bueno')]"/>
                <separator/>
                <group expand="0" string="Agrupar Por">
                    <filter string="Tipo" name="group_tipo" context="{'group_by':'tipo'}"/>
                    <filter string="Estado de Conservación" name="group_estado" context="{'group_by':'estado_conservacion'}"/>
                    <filter string="Meta Financiera" name="group_meta" context="{'group_by':'meta_financiera_id'}"/>
                    <filter string="Fecha de Adquisición" name="group_fecha" context="{'group_by':'fecha_adquisicion'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Acción de ventana -->
    <record id="action_diogenes_activo" model="ir.actions.act_window">
        <field name="name">Activos</field>
        <field name="res_model">diogenes.activo</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_active': 1, 'search_default_vendible': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crear el primer activo
            </p>
            <p>
                Los activos son bienes que posees y que pueden venderse para alcanzar 
                metas financieras: inmuebles, vehículos, electrónicos, inversiones, etc.
            </p>
        </field>
    </record>
              
</odoo>
