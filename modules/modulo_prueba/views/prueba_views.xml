<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista de lista -->
    <record id="view_modulo_prueba_tree" model="ir.ui.view">
        <field name="name">modulo.prueba.tree</field>
        <field name="model">modulo.prueba</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="priority" widget="priority"/>
                <field name="progress" widget="progressbar"/>
                <field name="user_id"/>
                <field name="date_created"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_modulo_prueba_form" model="ir.ui.view">
        <field name="name">modulo.prueba.form</field>
        <field name="model">modulo.prueba</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete" 
                            string="Marcar Completado" 
                            type="object" 
                            class="btn-primary"
                            invisible="progress == 100.0"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="priority"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="progress"/>
                            <field name="date_created"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Descripción">
                            <field name="description"/>
                        </page>
                        <page string="Etiquetas">
                            <field name="tag_ids" widget="many2many_tags"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de búsqueda -->
    <record id="view_modulo_prueba_search" model="ir.ui.view">
        <field name="name">modulo.prueba.search</field>
        <field name="model">modulo.prueba</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="description"/>
                <field name="user_id"/>
                <filter string="Activos" name="active" domain="[('active', '=', True)]"/>
                <filter string="Inactivos" name="inactive" domain="[('active', '=', False)]"/>
                <filter string="Alta Prioridad" name="high_priority" domain="[('priority', 'in', ['high', 'urgent'])]"/>
                <group expand="0" string="Agrupar por">
                    <filter string="Usuario" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Prioridad" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_modulo_prueba" model="ir.actions.act_window">
        <field name="name">Registros de Prueba</field>
        <field name="res_model">modulo.prueba</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_modulo_prueba_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                ¡Crea tu primer registro de prueba!
            </p>
            <p>
                Este es un módulo de demostración donde puedes crear registros de prueba
                para verificar que todo funciona correctamente.
            </p>
        </field>
    </record>

    <!-- Vista para etiquetas -->
    <record id="view_modulo_prueba_tag_tree" model="ir.ui.view">
        <field name="name">modulo.prueba.tag.tree</field>
        <field name="model">modulo.prueba.tag</field>
        <field name="arch" type="xml">
            <tree editable="top">
                <field name="name"/>
                <field name="color" widget="color"/>
            </tree>
        </field>
    </record>

    <record id="action_modulo_prueba_tag" model="ir.actions.act_window">
        <field name="name">Etiquetas</field>
        <field name="res_model">modulo.prueba.tag</field>
        <field name="view_mode">tree</field>
    </record>
</odoo>
