# Solo mantener módulos personalizados
# Los módulos deben estar en carpetas específicas como:
# modules/
# addons/
# custom_modules/

# Incluir archivos importantes del repositorio
!README.md
!.gitignore

# Incluir carpetas de módulos
!modules/
!modules/**/

# Incluir archivos Python de módulos específicos
!modules/**/*.py
!modules/**/*.xml
!modules/**/*.csv
!modules/**/*.json
!modules/**/*.yml
!modules/**/*.yaml
!modules/**/*.md
!modules/**/*.rst
!modules/**/static/
